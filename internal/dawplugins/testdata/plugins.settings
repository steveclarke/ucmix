<?xml version="1.0" encoding="UTF-8"?>
<!-- Hand-written fixture in the shape of Studio Pro's Plugins-en.settings. -->
<Settings xmlns:x="https://ccl.dev/xml" name="Plugins-en" version="1">
	<Section path="AAAA/Amp Thing.vst3">
		<Attributes numClasses="1">
			<Version x:id="version" version="1.0" vendor="Example Audio"/>
			<List x:id="Classes">
				<ClassDescription classID="{11111111-1111-1111-1111-111111111111}" category="AudioEffect" name="Amp Thing 7" subCategory="VST3"/>
			</List>
		</Attributes>
	</Section>
	<Section path="BBBB/Pro EQ">
		<Attributes numClasses="2">
			<Version x:id="version" vendor="Fender"/>
			<List x:id="Classes">
				<ClassDescription classID="{22222222-2222-2222-2222-222222222222}" category="AudioEffect" name="Pro EQ" subCategory="(Native)/EQ"/>
				<ClassDescription classID="{33333333-3333-3333-3333-333333333333}" category="AudioSynth" name="Mai Tai" subCategory="(Native)"/>
			</List>
		</Attributes>
	</Section>
	<Section path="CCCC/codec">
		<Attributes numClasses="1">
			<List x:id="Classes">
				<ClassDescription classID="{44444444-4444-4444-4444-444444444444}" category="AudioCodec" name="Pro Codec"/>
			</List>
		</Attributes>
	</Section>
	<Section path="DDDD/Pro EQ Legacy.vst3">
		<Attributes numClasses="1">
			<List x:id="Classes">
				<ClassDescription classID="{55555555-5555-5555-5555-555555555555}" category="AudioEffect" name="Pro EQ Legacy" subCategory="VST3"/>
			</List>
		</Attributes>
	</Section>
</Settings>
